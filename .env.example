# Copy to .env and fill in. Never put real keys in this file — it is committed.

# LLM — set at least one key. With only one key set, that provider is the default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=            # optional: Azure OpenAI / compatible gateway
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# LLM_PROVIDER=openai         # default provider when both keys are set (otherwise anthropic)

# Operator token for POST /admin/tenants (24+ chars). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Derives each tenant's webhook signing key (32+ chars). Never change after tenants are live.
WEBHOOK_SIGNING_SECRET=

# Optional locally (falls back to in-memory); required when NODE_ENV=production.
# Matches docker-compose.yml: docker compose up -d
DATABASE_URL=postgres://shop:shop@localhost:5544/shop
REDIS_URL=redis://localhost:6390

PORT=8080
